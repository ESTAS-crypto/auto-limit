# Quota Radar Konfigurasi Lingkungan (.env.local)

# Konfigurasi Supabase (Wajib jika menggunakan Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Kunci Enkripsi 32-byte (Hex atau Base64) untuk AES-256-GCM Kredensial & Webhook
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Koneksi Database Postgres Langsung (Opsional, untuk wizard setup migrasi otomatis)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Provider Kuota: 'mock' (Data contoh), 'ccs' (CCS CLI Proxy), atau 'antigravity-cli'
QUOTA_PROVIDER=mock

# Path Direktori CCS (jika memakai provider CCS)
CCS_HOME=

# Path Direktori antigravity-cli (jika memakai provider antigravity-cli)
ANTIGRAVITY_CLI_DIR=

# Perintah Kustom Penggantian Akun (Template {nickname}, kosong secara default)
SWITCH_COMMAND=

# Server Lokal & Polling
PORT=3000
HOST=127.0.0.1
POLL_INTERVAL_SECONDS=60

# Google OAuth Credentials (untuk refresh token Google Cloud Code)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

